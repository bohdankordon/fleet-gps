{
  "name": "taxi-gps-api-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "api:config": "tsx src/scripts/config-check.ts",
    "api:devices": "tsx src/scripts/devices-probe.ts",
    "api:positions": "tsx src/scripts/positions-probe.ts",
    "api:positions:built": "node dist/scripts/positions-probe.js",
    "api:summary": "tsx src/scripts/summary-probe.ts",
    "api:summary:built": "node dist/scripts/summary-probe.js",
    "api:report-routing:built": "node dist/scripts/report-routing-probe.js",
    "api:web:built": "node dist/scripts/web-api-probe.js",
    "api:session-token:built": "node dist/scripts/session-token-probe.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test dist/equgps/equgps-schemas.test.js dist/equgps/equgps-position.test.js dist/equgps/equgps-summary.test.js dist/equgps/equgps-session.test.js dist/equgps-web/equgps-web.test.js"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "luxon": "^3.7.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.3",
    "@types/node": "^24.0.15",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
