[Unit]
Description=Taxi GPS host monitor (one-shot health and failure detection)
Wants=network-online.target
After=network-online.target
# Monitor EXECUTION failure (nonzero exit) triggers one operational
# notification. Ordinary application incidents do NOT exit nonzero, so they do
# not spam OnFailure every minute.
OnFailure=taxi-gps-ops-notify@monitor.service

[Service]
Type=oneshot
WorkingDirectory=/opt/taxi-gps
# The wrapper owns the shared crash-released host flock and execs the Node
# monitor with the explicit production env file.
ExecStart=/bin/sh /opt/taxi-gps/ops/monitor-host.sh .env.production
# A monitor run must be time-bounded: a hung run is killed before the next tick.
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
