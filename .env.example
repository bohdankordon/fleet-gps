HOST=127.0.0.1
PORT=3000
POSTGRES_USER=taxi_gps
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=taxi_gps
POSTGRES_PORT=5433
DATABASE_URL=postgresql://taxi_gps:change-me-local@127.0.0.1:5433/taxi_gps?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
EQUGPS_BASE_URL=https://trace.equgps.com/api
EQUGPS_EMAIL=
EQUGPS_PASSWORD=
EQUGPS_TIMEZONE=Europe/Kyiv
EQUGPS_REQUEST_TIMEOUT_MS=15000
EQUGPS_RUNS_TIMEOUT_MS=45000
EQUGPS_WEB_BASE_URL=https://gps.equgps.com
EQUGPS_WEB_TOKEN=
API_INTERNAL_BASE_URL=http://127.0.0.1:3000

# Public map presentation override; defaults to OpenFreeMap Positron when unset.
NEXT_PUBLIC_MAP_STYLE_URL=

# Scheduler (disabled by default)
SYNC_SCHEDULER_ENABLED=false
FLEET_SYNC_INTERVAL_SECONDS=60
RUNS_SYNC_INTERVAL_SECONDS=300
SYNC_SCHEDULER_SHUTDOWN_TIMEOUT_MS=50000

# Fleet-to-alert ingestion (disabled by default)
ALERT_INGESTION_ENABLED=false

# Automatic rolling GPS-history maintenance (disabled by default)
POSITION_HISTORY_MAINTENANCE_ENABLED=false
# Required when enabled; each SYSTEM run may commit at most this many hourly windows (1..5000).
POSITION_HISTORY_MAINTENANCE_WINDOW_BUDGET=2000

# Automatic GPS-history retention deletion (disabled by default)
POSITION_HISTORY_RETENTION_ENABLED=false

# Legacy global product Telegram delivery (disabled by default)
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATION_DISPATCH_INTERVAL_MS=60000
TELEGRAM_NOTIFICATION_BATCH_SIZE=20

# Per-user product Telegram (disabled by default)
TELEGRAM_PRODUCT_LINKING_ENABLED=false
TELEGRAM_PRODUCT_BOT_USERNAME=
TELEGRAM_PRODUCT_BOT_TOKEN=
TELEGRAM_PRODUCT_WEBHOOK_SECRET=
TELEGRAM_PER_USER_NOTIFICATIONS_ENABLED=false
TELEGRAM_PER_USER_DISPATCH_ENABLED=false
TELEGRAM_PER_USER_DISPATCH_INTERVAL_MS=60000
TELEGRAM_PER_USER_DISPATCH_BATCH_SIZE=20
TELEGRAM_PER_USER_DISPATCH_NOT_BEFORE=
