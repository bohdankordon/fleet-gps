# Sanitized production configuration. Inject all empty secrets at deployment time.
NODE_ENV=production

# Internal Nest listener and Browser -> Next BFF -> Nest connection.
HOST=127.0.0.1
PORT=3000
API_INTERNAL_BASE_URL=http://api:3000

# PostgreSQL (secret; no repository placeholder is accepted in production).
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# eQuGPS provider credentials (secrets are deployment-injected).
EQUGPS_BASE_URL=https://trace.equgps.com/api
EQUGPS_WEB_BASE_URL=https://gps.equgps.com
EQUGPS_EMAIL=
EQUGPS_PASSWORD=
EQUGPS_REQUEST_TIMEOUT_MS=15000
EQUGPS_RUNS_TIMEOUT_MS=45000

# Optional public map style override; blank uses OpenFreeMap Positron.
# Production accepts only HTTPS URLs on https://tiles.openfreemap.org.
NEXT_PUBLIC_MAP_STYLE_URL=

# Automatic/provider-affecting work is opt-in and disabled by default.
SYNC_SCHEDULER_ENABLED=false
FLEET_SYNC_INTERVAL_SECONDS=60
RUNS_SYNC_INTERVAL_SECONDS=300
SYNC_SCHEDULER_SHUTDOWN_TIMEOUT_MS=50000
ALERT_INGESTION_ENABLED=false
POSITION_HISTORY_MAINTENANCE_ENABLED=false
# Required when enabled. Stage 24B's intended initial production limit is 2000
# hourly windows per automatically created SYSTEM maintenance run (1..5000).
POSITION_HISTORY_MAINTENANCE_WINDOW_BUDGET=2000
POSITION_HISTORY_RETENTION_ENABLED=false

# Telegram is opt-in. Credentials remain empty while disabled.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATION_DISPATCH_INTERVAL_MS=60000
TELEGRAM_NOTIFICATION_BATCH_SIZE=20

# Per-user product Telegram is deploy-dark by default. These are independent
# from legacy product delivery above. Never enable both dispatchers together.
# The webhook secret is one shared, server-only value for API and Web ingress.
TELEGRAM_PRODUCT_LINKING_ENABLED=false
TELEGRAM_PRODUCT_BOT_USERNAME=
TELEGRAM_PRODUCT_BOT_TOKEN=
TELEGRAM_PRODUCT_WEBHOOK_SECRET=
TELEGRAM_PER_USER_NOTIFICATIONS_ENABLED=false
TELEGRAM_PER_USER_DISPATCH_ENABLED=false
TELEGRAM_PER_USER_DISPATCH_INTERVAL_MS=60000
TELEGRAM_PER_USER_DISPATCH_BATCH_SIZE=20
# Required only when per-user dispatch is true. Use an ISO-8601 UTC/offset
# instant, e.g. 2026-08-30T14:05:00Z; do not use a local business-time date.
TELEGRAM_PER_USER_DISPATCH_NOT_BEFORE=

# Stage 23 operational incident alerts (host-level monitor). This is INDEPENDENT
# from TELEGRAM_NOTIFICATIONS_ENABLED above and reuses the SAME bot token/chat
# ID when enabled. Strictly true or false; anything else fails preflight.
OPS_ALERTS_ENABLED=false

# =============================================================================
# Stage 22 deployment fields (single Linux host, Docker Engine + Compose v2).
# =============================================================================

# Public Caddy edge. Operator-controlled domain, used only by Caddy for the
# public HTTPS site (never hard-code the real production domain here).
SITE_ADDRESS=https://taxi.example.com

# Exact immutable application release identity (Git tag/revision). Never "latest".
APP_IMAGE_TAG=v1.0.0

# PostgreSQL 17 bootstrap for the Dockerized database. These duplicate facts in
# DATABASE_URL by design; the canonical explicit-env production preflight
# detects decoded user/password/database mismatches without printing credential
# values. In production DATABASE_URL must equal:
# postgresql://<POSTGRES_USER>:<password>@postgres:5432/<POSTGRES_DB>?schema=public
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Absolute host backup directory (durable, outside the repository). Required by
# the one-shot backup/restore jobs. Keep it on durable storage and maintain an
# encrypted off-host copy.
BACKUP_DIR=/srv/taxi-gps/backups

# Retain this many complete verified managed pairs. Strict positive decimal
# integers only; invalid values fail the preflight and backup before pg_dump.
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
