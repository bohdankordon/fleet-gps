# Sanitized production configuration. Inject all empty secrets at deployment time.
NODE_ENV=production

# Internal Nest listener and Browser -> Next BFF -> Nest connection.
HOST=127.0.0.1
PORT=3000
API_INTERNAL_BASE_URL=http://api:3000

# PostgreSQL (secret; no repository placeholder is accepted in production).
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# eQuGPS provider credentials (secrets are deployment-injected).
EQUGPS_BASE_URL=https://trace.equgps.com/api
EQUGPS_WEB_BASE_URL=https://gps.equgps.com
EQUGPS_EMAIL=
EQUGPS_PASSWORD=
EQUGPS_REQUEST_TIMEOUT_MS=15000
EQUGPS_RUNS_TIMEOUT_MS=45000

# Optional public map style override; blank uses OpenFreeMap Positron.
# Production accepts only HTTPS URLs on https://tiles.openfreemap.org.
NEXT_PUBLIC_MAP_STYLE_URL=

# Automatic/provider-affecting work is opt-in and disabled by default.
SYNC_SCHEDULER_ENABLED=false
FLEET_SYNC_INTERVAL_SECONDS=60
RUNS_SYNC_INTERVAL_SECONDS=300
SYNC_SCHEDULER_SHUTDOWN_TIMEOUT_MS=50000
ALERT_INGESTION_ENABLED=false
POSITION_HISTORY_MAINTENANCE_ENABLED=false
POSITION_HISTORY_RETENTION_ENABLED=false

# Telegram is opt-in. Credentials remain empty while disabled.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATION_DISPATCH_INTERVAL_MS=60000
TELEGRAM_NOTIFICATION_BATCH_SIZE=20
