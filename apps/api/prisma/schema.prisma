generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum VehicleStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum DailyStatSource {
  RUNS
  MODE1
  HISTORICAL_POSITIONS
}

enum DataQuality {
  EXACT
  PROVISIONAL
  ESTIMATED
}

enum PositionIngestionSource {
  FLEET_SYNC
  HISTORICAL_BACKFILL
}

enum AlertEventType {
  SPEEDING
  INACTIVITY
}

enum AlertEventStatus {
  OPEN
  RESOLVED
}

enum AlertEventSpeedZone {
  CITY
  OUTSIDE_CITY
}

enum AlertNotificationKind {
  ALERT_CONFIRMED
}

enum AlertNotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model Vehicle {
  id                          String                       @id @default(uuid()) @map("id") @db.Uuid
  externalDeviceId            Int                          @unique @map("external_device_id")
  name                        String                       @map("name") @db.VarChar(255)
  disabled                    Boolean                      @default(false) @map("disabled")
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  currentState                VehicleCurrentState?
  dailyStats                  DailyVehicleStat[]
  positionObservations        VehiclePositionObservation[]
  alertEvents                 AlertEvent[]
  alertEvaluationObservations AlertEvaluationObservation[]

  @@map("vehicles")
}

model VehiclePositionObservation {
  id                String                  @id @default(uuid()) @map("id") @db.Uuid
  vehicleId         String                  @map("vehicle_id") @db.Uuid
  fixFingerprint    String                  @map("fix_fingerprint") @db.VarChar(64)
  observedAt        DateTime                @map("observed_at") @db.Timestamptz(6)
  latitude          Float                   @map("latitude")
  longitude         Float                   @map("longitude")
  speedKph          Float?                  @map("speed_kph")
  valid             Boolean?                @map("valid")
  outdated          Boolean?                @map("outdated")
  fetchedAt         DateTime                @map("fetched_at") @db.Timestamptz(6)
  ingestionSource   PositionIngestionSource @map("ingestion_source")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  vehicle           Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@unique([vehicleId, fixFingerprint])
  @@index([vehicleId, observedAt, fixFingerprint], map: "vehicle_position_observations_vehicle_time_idx")
  @@index([observedAt])
  @@map("vehicle_position_observations")
}

model AlertEvaluationObservation {
  id          String    @id @default(uuid()) @map("id") @db.Uuid
  vehicleId   String    @map("vehicle_id") @db.Uuid
  observedAt  DateTime  @map("observed_at") @db.Timestamptz(6)
  latitude    Float     @map("latitude")
  longitude   Float     @map("longitude")
  speedKph    Float     @map("speed_kph")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  replayEligible Boolean? @map("replay_eligible")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@unique([vehicleId, observedAt])
  @@index([vehicleId, processedAt, observedAt])
  @@index([vehicleId, replayEligible, observedAt])
  @@map("alert_evaluation_observations")
}

model AlertEvent {
  id                                 String                   @id @default(uuid()) @map("id") @db.Uuid
  vehicleId                          String                   @map("vehicle_id") @db.Uuid
  type                               AlertEventType           @map("type")
  status                             AlertEventStatus         @map("status")
  confirmedAt                        DateTime                 @map("confirmed_at") @db.Timestamptz(6)
  lastObservedAt                     DateTime                 @map("last_observed_at") @db.Timestamptz(6)
  resolvedAt                         DateTime?                @map("resolved_at") @db.Timestamptz(6)
  dedupeKey                          String                   @unique @map("dedupe_key") @db.VarChar(64)
  activeKey                          String?                  @unique @map("active_key") @db.VarChar(64)
  speedZone                          AlertEventSpeedZone?     @map("speed_zone")
  confirmationSpeedKph               Float?                   @map("confirmation_speed_kph")
  lastSpeedKph                       Float?                   @map("last_speed_kph")
  peakSpeedKph                       Float?                   @map("peak_speed_kph")
  speedThresholdKph                  Float?                   @map("speed_threshold_kph")
  confirmationTraveledDistanceMeters Float?                   @map("confirmation_traveled_distance_meters")
  lastTraveledDistanceMeters         Float?                   @map("last_traveled_distance_meters")
  minimumTraveledDistanceMeters      Float?                   @map("minimum_traveled_distance_meters")
  distanceThresholdMeters            Float?                   @map("distance_threshold_meters")
  durationThresholdMinutes           Int?                     @map("duration_threshold_minutes")
  createdAt                          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicle                            Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  confirmations                      AlertEventConfirmation[]
  notificationOutbox                 AlertNotificationOutbox[]

  @@index([vehicleId, type, status])
  @@index([status, confirmedAt])
  @@index([type, confirmedAt])
  @@map("alert_events")
}

model AlertNotificationOutbox {
  id            String                  @id @default(uuid()) @map("id") @db.Uuid
  alertEventId  String                  @map("alert_event_id") @db.Uuid
  kind          AlertNotificationKind   @map("kind")
  status        AlertNotificationStatus @default(PENDING) @map("status")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  availableAt   DateTime                @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt      DateTime?               @map("locked_at") @db.Timestamptz(6)
  lockToken     String?                 @map("lock_token") @db.Uuid
  sentAt        DateTime?               @map("sent_at") @db.Timestamptz(6)
  attemptCount  Int                     @default(0) @map("attempt_count")
  lastAttemptAt DateTime?               @map("last_attempt_at") @db.Timestamptz(6)
  lastErrorCode String?                 @map("last_error_code") @db.VarChar(32)
  alertEvent    AlertEvent              @relation(fields: [alertEventId], references: [id], onDelete: Restrict)

  @@unique([alertEventId, kind])
  @@index([status, availableAt, createdAt, id])
  @@map("alert_notification_outbox")
}

model AlertEventConfirmation {
  dedupeKey  String     @id @map("dedupe_key") @db.VarChar(64)
  eventId    String     @map("event_id") @db.Uuid
  observedAt DateTime   @map("observed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  event      AlertEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@map("alert_event_confirmations")
}

model VehicleCurrentState {
  vehicleId            String        @id @map("vehicle_id") @db.Uuid
  status               VehicleStatus @default(UNKNOWN) @map("status")
  externalLastUpdateAt DateTime?     @map("external_last_update_at") @db.Timestamptz(6)
  fixTime              DateTime?     @map("fix_time") @db.Timestamptz(6)
  latitude             Float?        @map("latitude")
  longitude            Float?        @map("longitude")
  speedKph             Float?        @map("speed_kph")
  valid                Boolean?      @map("valid")
  outdated             Boolean?      @map("outdated")
  fetchedAt            DateTime      @default(now()) @map("fetched_at") @db.Timestamptz(6)
  vehicle              Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_current_states")
}

model DailyVehicleStat {
  id                      String          @id @default(uuid()) @map("id") @db.Uuid
  vehicleId               String          @map("vehicle_id") @db.Uuid
  serviceDate             DateTime        @map("service_date") @db.Date
  distanceMeters          Decimal         @map("distance_meters") @db.Decimal(14, 2)
  movementDurationSeconds Int?            @map("movement_duration_seconds")
  maxSpeedKph             Decimal?        @map("max_speed_kph") @db.Decimal(8, 3)
  source                  DailyStatSource @map("source")
  quality                 DataQuality     @map("quality")
  isStale                 Boolean         @default(false) @map("is_stale")
  isDegraded              Boolean         @default(false) @map("is_degraded")
  fetchedAt               DateTime        @default(now()) @map("fetched_at") @db.Timestamptz(6)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicle                 Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, serviceDate])
  @@index([serviceDate])
  @@index([source])
  @@map("daily_vehicle_stats")
}

model ApplicationSettings {
  id                          Int      @id @default(1) @map("id")
  timezone                    String   @default("Europe/Kyiv") @map("timezone") @db.VarChar(64)
  minimumDailyDistanceMeters  Int      @default(500) @map("minimum_daily_distance_meters")
  citySpeedLimitKph           Int      @default(50) @map("city_speed_limit_kph")
  outsideCitySpeedLimitKph    Int      @default(90) @map("outside_speed_limit_kph")
  speedToleranceKph           Int      @default(10) @map("speed_tolerance_kph")
  speedRuleEnabled            Boolean  @default(true) @map("speed_rule_enabled")
  inactivityRuleEnabled       Boolean  @default(true) @map("inactivity_rule_enabled")
  speedingConfirmationUpdates Int      @default(2) @map("speeding_confirmation_updates")
  inactivityDistanceMeters    Int      @default(300) @map("inactivity_distance_meters")
  inactivityDurationMinutes   Int      @default(60) @map("inactivity_duration_minutes")
  cityGeofenceGeoJson         Json?    @map("city_geofence_geo_json")
  positionFreshnessSeconds    Int      @default(300) @map("position_freshness_seconds")
  telegramChatId              String?  @map("telegram_chat_id") @db.VarChar(128)
  dailyReportMinuteOfDay      Int      @default(10) @map("daily_report_minute_of_day")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("application_settings")
}
