{
  "name": "@taxi-gps/web",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "maplibre:prepare-worker": "node scripts/copy-maplibre-worker.cjs",
    "predev": "npm run maplibre:prepare-worker",
    "dev": "next dev",
    "prebuild": "npm run maplibre:prepare-worker",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/clean-output.cjs .test-dist && tsc -p tsconfig.test.json && node scripts/run-tests.cjs",
    "dashboard:smoke": "npm run build && node scripts/dashboard-ui-smoke.cjs",
    "open-alert-map:smoke": "npm run build && node scripts/open-alert-map-ui-smoke.cjs",
    "scheduler:observe": "node scripts/scheduler-runtime-observer.cjs",
    "scheduler:observe:test": "node --test scripts/scheduler-runtime-observer.test.cjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.2.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.3"
  }
}
