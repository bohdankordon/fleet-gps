{
  "name": "@taxi-gps/web",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
